# Left unset in normal dev — Vite's dev-server proxy (vite.config.ts) forwards /api to
# http://localhost:8080, and Nginx does the same in production, so the client's default
# baseURL ('/api/v1', relative) works in both environments without this variable.
# Only set this if the backend runs somewhere the proxy doesn't cover.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
